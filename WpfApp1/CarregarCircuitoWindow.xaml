<Window x:Class="WpfApp1.CarregarCircuitoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carregar Circuito" Height="350" Width="450"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Images/logo.ico">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgCircuitos"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Carregar"
                Margin="0,10,0,0" Height="30"
                HorizontalAlignment="Right" Width="100"
                Click="BtnCarregar_Click"/>
    </Grid>
</Window>
