<Window x:Class="WpfApp1.SimuladorCircuito"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="SimuladorCircuito" Height="450" Width="800">

    <Grid>
        <!-- Definindo 2 colunas: simulador ocupa tudo e menu lateral ocupa a direita -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!-- Área do simulador -->
        <Canvas x:Name="cnvSimulador" 
                Background="#FFDADADA"
                Margin="10"
                Grid.Column="0" />

        <!-- Menu lateral -->
        <StackPanel Grid.Column="1" Margin="10">
            <Label Content="MENU" 
                   FontFamily="Century Gothic" 
                   FontWeight="Bold" 
                   FontSize="20"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

            <Label Content="Adicionar Porta" 
                   FontFamily="Century Gothic" 
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

            <ComboBox x:Name="cmbPorta" 
                      Width="150"
                      FontFamily="Century Gothic"
                      Background="White"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10">
                <ComboBoxItem Content="Porta AND"/>
                <ComboBoxItem Content="Porta NAND"/>
                <ComboBoxItem Content="Porta OR"/>
                <ComboBoxItem Content="Porta NOR"/>
                <ComboBoxItem Content="Porta XOR"/>
                <ComboBoxItem Content="Porta XNOR"/>
            </ComboBox>

            <Button x:Name="btnSalvar" 
                    Width="150"
                    Content="Salvar Circuito"
                    FontSize="10"
                    FontFamily="Century Gothic"
                    Background="#FFEAEAEA" 
                    BorderBrush="#FFACACAC"
                    Margin="0,0,0,10"/>
            <Button x:Name="btnCarregar" 
                    Width="150"
                    Content="Carregar Circuito"
                    FontSize="10"
                    FontFamily="Century Gothic"
                    Background="#FFEAEAEA" 
                    BorderBrush="#FFACACAC"
                    Margin="0,0,0,10"/>
            <Button x:Name="btnExportar" 
                    Width="150"
                    Content="Exportar Circuito"
                    FontSize="10"
                    FontFamily="Century Gothic"
                    Background="#FFEAEAEA" 
                    BorderBrush="#FFACACAC"
                    Margin="0,0,0,10"/>
        </StackPanel>
    </Grid>
</Window>
