<UserControl x:Class="WpfApp1.Controls.OutputNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="70">
    <Canvas>
        <!-- Nome OUTPUT -->
        <TextBlock Text="Saída" Canvas.Left="30" Canvas.Top="5"
                   FontWeight="Bold"/>

        <!-- Ponto de ENTRADA (onde o fio liga) -->
        <Ellipse x:Name="Input"
                 Width="12" Height="12"
                 Canvas.Left="5" Canvas.Top="28"
                 Fill="Gray"
                 MouseDown="InputPort_MouseDown"/>

        <!-- Indicador de valor lógico -->
        <Ellipse x:Name="DisplayLight"
                 Width="20" Height="20"
                 Canvas.Left="65" Canvas.Top="25"
                 Stroke="Black" Fill="Gray"/>
    </Canvas>
</UserControl>
