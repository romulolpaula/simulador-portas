<UserControl x:Class="WpfApp1.Controls.GateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="70">
    <Canvas>
        <Image x:Name="ImgGate" Width="80" Height="60" Canvas.Left="10" Canvas.Top="5"/>
        <!-- Inputs (pequenas elipses) -->
        <Ellipse x:Name="Input0" Width="10" Height="10" Canvas.Left="0" Canvas.Top="15" Fill="Gray" MouseDown="InputPort_MouseDown" />
        <Ellipse x:Name="Input1" Width="10" Height="10" Canvas.Left="0" Canvas.Top="35" Fill="Gray" MouseDown="InputPort_MouseDown" />
        <!-- Output -->
        <Ellipse x:Name="Output" Width="12" Height="12" Canvas.Left="88" Canvas.Top="28" Fill="Gray" MouseDown="OutputPort_MouseDown" />
    </Canvas>
</UserControl>
