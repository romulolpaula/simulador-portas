<UserControl x:Class="WpfApp1.Controls.InputNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="70">
    <Canvas>
        <!-- Checkbox para alternar entrada -->
        <CheckBox x:Name="chkValue" Content="Entrada"
                  Canvas.Left="5" Canvas.Top="5"
                  Checked="ChkValue_Checked"
                  Unchecked="ChkValue_Unchecked"/>
        <!-- Saída (igual às portas lógicas) -->
        <Ellipse x:Name="Output" Width="12" Height="12"
                 Canvas.Left="80" Canvas.Top="28"
                 Fill="Gray" MouseDown="OutputPort_MouseDown"/>
    </Canvas>
</UserControl>
