<UserControl x:Class="WpfApp1.Controls.InputNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="70">
    <StackPanel>
        <CheckBox x:Name="chkValue" Content="Entrada" 
                  Checked="chkValue_Changed" 
                  Unchecked="chkValue_Changed"/>
        <!-- bolinha de saída -->
        <Ellipse x:Name="Output"
                 Width="15" Height="15"
                 Fill="Gray"
                 Stroke="Black"
                 StrokeThickness="1"
                 Margin="5"
                 MouseDown="OutputPort_MouseDown"/>
    </StackPanel>
</UserControl>
