<Window x:Class="WpfApp1.MapaK"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapa de Karnaugh" Height="640" Width="900"
        FontFamily="Century Gothic"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">Variáveis:</TextBlock>
            <ComboBox x:Name="cmbVars" Width="70" SelectedIndex="1">
                <ComboBoxItem>2</ComboBoxItem>
                <ComboBoxItem>3</ComboBoxItem>
                <ComboBoxItem>4</ComboBoxItem>
            </ComboBox>

            <TextBlock VerticalAlignment="Center" Margin="12,0,8,0">Entrada (minterms separados por vírgula ou string de bits):</TextBlock>
            <TextBox x:Name="txtInput" Width="260" VerticalAlignment="Center"/>

            <Button Content="Gerar" Margin="12,0,0,0" Padding="8,4" Click="BtnGenerate_Click"/>
            <Button Content="Auto Agrupar" Margin="6,0,0,0" Padding="8,4" Click="BtnAutoGroup_Click"/>
            <Button Content="Exportar PNG" Margin="6,0,0,0" Padding="8,4" Click="BtnExport_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="karnaughCanvas" Background="White"/>
        </ScrollViewer>

        <TextBox x:Name="txtExpressaoSimplificada" Grid.Row="2" Height="84" Margin="0,8,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
    </Grid>
</Window>
