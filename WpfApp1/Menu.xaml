<Window x:Class="WpfApp1.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Menu" Height="450" Width="800"
        MinHeight="400" MinWidth="600">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="*"/>
            <!-- Botões -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <Label Grid.Row="0" 
               x:Name="lblMenu" 
               Content="MENU" 
               HorizontalAlignment="Center"
               FontFamily="Century Gothic" 
               FontWeight="Bold" 
               FontSize="30" 
               Foreground="Black" 
               Margin="0,10,0,20"/>

        <!-- Botões centralizados -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top" 
                    Width="250">

            <Button x:Name="btnSimularCircuito" 
                    Content="Simular Circuito" 
                    Height="50" 
                    FontFamily="Century Gothic"
                    Background="Aquamarine"
                    Margin="0,0,0,30">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="LightGray" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnSimularMapa" 
                    Content="Simular Tabela Verdade" 
                    Height="50" 
                    FontFamily="Century Gothic"
                    Background="Aquamarine"
                    Margin="0,0,0,30">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="LightGray" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnSimularKarnaugh" 
                    Content="Simular Mapa de Karnaugh" 
                    Height="50" 
                    FontFamily="Century Gothic"
                    Background="Aquamarine"
                    Margin="0,0,0,30">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="LightGray" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnModelos" 
                    Content="Modelos Exemplificados" 
                    Height="50" 
                    FontFamily="Century Gothic"
                    Background="Aquamarine">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="LightGray" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Grid>
</Window>
