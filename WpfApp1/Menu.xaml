<Window x:Class="WpfApp1.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Menu" Height="450" Width="800"
        MinHeight="400" MinWidth="600"
        Icon="pack://application:,,,/Images/logo.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Bem-vindo -->
            <RowDefinition Height="*"/>
            <!-- Botões -->
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <Label Grid.Row="0"
               x:Name="lblMenu"
               Content="MENU"
               HorizontalAlignment="Center"
               FontFamily="Century Gothic"
               FontWeight="Bold"
               FontSize="30"
               Foreground="Black"
               Margin="0,10,0,10"/>

        <!-- TEXTO DE BEM-VINDO -->
        <Label Grid.Row="1"
               x:Name="lblBemVindo"
               Content="Olá!"
               HorizontalAlignment="Center"
               FontFamily="Century Gothic"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,25"/>

        <!-- BOTÕES -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="250"
                    Margin="0,20,0,0">

            <Button x:Name="btnSimularCircuito"
                    Content="Simular Circuito"
                    Height="50"
                    FontFamily="Century Gothic"
                    Background="Aquamarine"
                    Margin="0,0,0,30"
                    Click="btnSimularCircuito_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="LightGray" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnSimularKarnaugh"
                    Content="Mapa de Karnaugh"
                    Height="50"
                    FontFamily="Century Gothic"
                    Background="Aquamarine"
                    Margin="0,0,0,30"
                    Click="btnSimularKarnaugh_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="LightGray" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Grid>
</Window>
